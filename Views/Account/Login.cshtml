<div class="mx-auto" style="max-width:380px">
  <h3 class="mb-3">تسجيل الدخول</h3>
  @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
  <form method="post">
    <input name="email" class="form-control mb-2" placeholder="Email" value="admin@demo.com" />
    <input name="password" type="password" class="form-control mb-3" placeholder="Password" value="Admin@123" />
    <button class="btn btn-primary w-100">دخول</button>
  </form>
</div>
